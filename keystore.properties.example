# Copy this file to `keystore.properties` (which is .gitignored) and fill in
# real values before building a release. Paths are resolved relative to the
# project root.
#
# Generate a keystore with:
#   keytool -genkey -v -keystore snapdoc-release.jks -keyalg RSA \
#       -keysize 2048 -validity 10000 -alias snapdoc
#
# Store the resulting .jks file OUTSIDE the repository (e.g. ~/.keystores/)
# and reference it here via an absolute path.

storeFile=../../keystores/snapdoc-release.jks
storePassword=CHANGE_ME
keyAlias=snapdoc
keyPassword=CHANGE_ME
