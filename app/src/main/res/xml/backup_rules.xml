<?xml version="1.0" encoding="utf-8"?>
<!--
  Auto Backup rules for devices on API 23-30.
  See https://developer.android.com/guide/topics/data/autobackup

  Strategy:
  - Exclude the user_prefs DataStore because it also caches the billing
    entitlement; restoring it from cloud could grant a refunded user
    continued access. Onboarding flag re-displaying after a restore is fine.
  - Cache files are never included in Auto Backup by default — no exclude needed.
  - Exclude external storage.
  - No files explicitly included -> nothing else is backed up.
-->
<full-backup-content>
    <exclude domain="file" path="datastore/user_prefs.preferences_pb" />
    <exclude domain="external" path="." />
</full-backup-content>
