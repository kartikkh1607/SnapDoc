<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Base activity theme. Compose Material 3 owns the runtime theming,
        so this only needs to be edge-to-edge friendly and lack an action bar.
    -->
    <style name="Theme.SnapDoc" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/snap_splash_background</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar" tools:targetApi="m">true</item>
        <item name="android:enforceStatusBarContrast" tools:targetApi="q">false</item>
        <item name="android:enforceNavigationBarContrast" tools:targetApi="q">false</item>
    </style>

    <!--
        Splash theme used by androidx.core:core-splashscreen. The system
        renders this *before* MainActivity is created, so it must live in XML.
    -->
    <style name="Theme.SnapDoc.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/snap_splash_background</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.SnapDoc</item>
    </style>
</resources>
